# Manuscript figure assembly v1. CPU-only; reads hashed reports, recomputes nothing.
# Explicit target only (`snakemake manuscript_figures_v1`); `all` is unchanged.
# The spec is loaded into its own variable rather than via `configfile:`, which
# would merge keys such as `output_dir` into the global config used by other rules.
import yaml as _manuscript_yaml

with open("docs/manuscript_figures_v1.yaml") as _handle:
    manuscript_spec = _manuscript_yaml.safe_load(_handle)

# Deliberately no declared outputs: Snakemake removes outputs before execution
# and on failure, which would bypass the builder's no-overwrite guard. Like the
# forensic release target, this is an explicit action. Frozen data dependencies
# are checked by the builder, not regenerated by upstream workflow rules.
rule manuscript_figures_v1:
    input:
        spec="docs/manuscript_figures_v1.yaml",
        code="src/analysis/manuscript_figures.py",
    params:
        destination=config.get("manuscript_figure_output_dir", manuscript_spec["output_dir"]),
    resources:
        gpu=0,
    shell:
        "python -m src.analysis.manuscript_figures --spec {input.spec:q} "
        "--output-dir {params.destination:q}"

# Paper authoring has a separate Python environment (python-docx/Pillow).
# Like figure assembly, these explicit actions have no cleanup-managed output.
rule manuscript_documents_v1:
    input:
        spec="docs/manuscript/paper_package_v1.json",
        code="src/analysis/paper_package.py",
    params:
        python=config.get("paper_document_python", "python"),
        destination=config.get("paper_document_output_dir", "results/manuscript_submission_v2/documents"),
    resources:
        gpu=0,
    shell:
        "{params.python:q} -m src.analysis.paper_package documents --output-dir {params.destination:q}"

rule manuscript_journal_figures_v1:
    input:
        spec="docs/manuscript/paper_package_v1.json",
        code="src/analysis/paper_package.py",
    params:
        destination=config.get("paper_journal_figure_output_dir", "results/manuscript_submission_v2/figures"),
    resources:
        gpu=0,
    shell:
        "python -m src.analysis.paper_package figures --output-dir {params.destination:q}"

rule manuscript_deposit_candidate_v1:
    input:
        spec="docs/manuscript/paper_package_v1.json",
        code="src/analysis/paper_deposit.py",
        instructions="docs/manuscript/deposit_instructions.txt",
    params:
        destination=config.get("paper_deposit_output_dir", "results/manuscript_submission_v2/deposit"),
    resources:
        gpu=0,
    shell:
        "python -m src.analysis.paper_deposit --output-dir {params.destination:q}"

rule manuscript_pdfs_v1:
    input:
        spec="docs/manuscript/paper_package_v1.json",
        code="src/analysis/paper_package.py",
    params:
        python=config.get("paper_document_python", "python"),
        renderer=config.get("paper_renderer", "render_docx.py"),
        font=config.get("paper_font_file", "/System/Library/Fonts/Supplemental/Times New Roman.ttf"),
        documents=config.get("paper_document_output_dir", "results/manuscript_submission_v2/documents"),
        figures=config.get("paper_journal_figure_output_dir", "results/manuscript_submission_v2/figures"),
        destination=config.get("paper_pdf_output_dir", "results/manuscript_submission_v2/pdf"),
    resources:
        gpu=0,
    shell:
        "{params.python:q} -m src.analysis.paper_package render --output-dir {params.destination:q} "
        "--renderer {params.renderer:q} --font-file {params.font:q} "
        "--documents-dir {params.documents:q} --figures-dir {params.figures:q}"
